# Database — Supabase: copie do painel Project Settings → Database
# Erro "Tenant or user not found": use conexão DIRECTA (host db.xxxxx.supabase.co, porta 5432, user postgres)
# ou ajuste o user do pooler (postgres.PROJECT_REF no modo Transaction). Veja README.
# Pooler Transaction (6543): o backend acrescenta pgbouncer=true se faltar (Prisma + PgBouncer).
# Pooler Session (5432) ou Direct: sem necessidade disso.
DATABASE_URL="postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres?sslmode=require"
# Obrigatório: conexão Direct para migrations. Se só tiver uma URI, duplique o valor de DATABASE_URL aqui.
DIRECT_URL="postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres?sslmode=require"

# Auth (obrigatório em produção — veja src/config/jwt.js)
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Único e-mail que pode fazer login (padrão: jvsp.ltda2@gmail.com)
ALLOWED_USER_EMAIL="jvsp.ltda2@gmail.com"

# Frontend (CORS)
FRONTEND_URL="http://localhost:5173"

# Server
PORT=3000
NODE_ENV="development"
TZ="America/Sao_Paulo"

# Câmbio USD→BRL usado em resumos, alertas e cripto em BRL (opcional)
USD_BRL=5.43

# Preços EUA (Alpha Vantage) — opcional; sem chave válida as cotações USA podem falhar
ALPHA_VANTAGE_KEY=""

# Brapi (ações/ETFs/BDRs BR) — opcional; alguns tickers retornam 401 sem token (brapi.dev)
BRAPI_TOKEN=""

# E-mail de alertas (Nodemailer) — opcional; sem isso, só notificação in-app
# Ex.: Gmail com "app password", SendGrid, Mailgun, servidor SMTP próprio
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Ex.: mesmo e-mail do proprietário ou no-reply do provedor
MAIL_FROM="jvsp.ltda2@gmail.com"
